{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kiyometa: Start tablet emulator",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tool\\start-tablet-emulator.ps1"
            ],
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            }
        },
        {
            "label": "Kiyometa: Run app on tablet",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tool\\start-tablet-emulator.ps1",
                "-RunApp"
            ],
            "problemMatcher": []
        }
    ]
}
