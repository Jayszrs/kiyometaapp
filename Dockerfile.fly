FROM node:22-alpine AS web-build
WORKDIR /webapp
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OCR_MODEL_DIR=/opt/ocr/models MAX_PDF_PAGES=3 MAX_UPLOAD_MB=25 OCR_MAX_CONCURRENT=2 SUPABASE_JWKS_URL=https://hhiklzunsjccbuvrutlg.supabase.co/auth/v1/.well-known/jwks.json

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ocr
COPY ocr-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY ocr-service/prepare_models.py ocr-service/main.py ocr-service/recognition.py ocr-service/jobs.py ./
RUN python prepare_models.py

COPY --from=web-build /webapp/dist /usr/share/nginx/html
COPY deploy/fly/nginx.conf /etc/nginx/nginx.conf
COPY deploy/fly/supervisord.conf /etc/supervisor/conf.d/kiyometa.conf

EXPOSE 8080
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
